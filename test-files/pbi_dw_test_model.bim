          {
            "name": "On Hand Qty (Latest Date)",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "expression": [
              "",
              "VAR MaxDate =",
              "    MAX ( DATE_DIM[d_date_sk] )",
              "RETURN",
              "CALCULATE (",
              "    [On Hand Qty],",
              "    DATE_DIM[d_date_sk] = MaxDate",
              ")"
            ],
            "lineageTag": "aac727b8-863e-4674-8cef-f9909d89cda4"
          }
        ],
