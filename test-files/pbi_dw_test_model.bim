            "displayFolder": "Basic Aggregations",
            "lineageTag": "e32a0c72-ed01-4b4b-bd9d-5c00ea72e636"
          },
          {
            "name": "Max Sale Price",
            "expression": "MAX(STORE_SALES[SS_SALES_PRICE])",
            "formatString": "#,##0.00",
            "displayFolder": "Basic Aggregations",
            "lineageTag": "be29a637-544d-4bec-a215-fec1232ed76e"
          },
          {
            "name": "Distinct Customers",
            "expression": "DISTINCTCOUNT(STORE_SALES[SS_CUSTOMER_SK])",
            "formatString": "#,##0",
            "displayFolder": "Basic Aggregations",
            "lineageTag": "fd133295-6dba-4369-b446-a2098530ec28"
          },
          {
            "name": "Weekend Sales",
            "expression": "CALCULATE([Total Sales], DATE_DIM[D_WEEKEND]=\"Y\")",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate Filters",
            "lineageTag": "171f56cc-6162-4a86-985f-9f3129e07189"
          },
          {
            "name": "Q1 Sales",
            "expression": "CALCULATE([Total Sales], DATE_DIM[D_QOY]=1)",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate Filters",
            "lineageTag": "6c122c11-e508-41dd-9c40-def0b006715e"
          },
          {
            "name": "Sales All Dates",
            "expression": "CALCULATE([Total Sales], ALL(DATE_DIM))",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate ALL",
            "lineageTag": "bf67ba2b-4e55-419d-9be4-72f55ac6f0ec"
          },
          {
            "name": "Sales All Years",
            "expression": "CALCULATE([Total Sales], ALL(DATE_DIM[D_YEAR]))",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate ALL",
            "lineageTag": "73789202-685a-4d9d-ac92-69bdf72d7460"
          },
          {
            "name": "Profit All Dates All Stores",
            "expression": "CALCULATE([Total Profit], ALL(DATE_DIM), ALL(STORE))",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate ALL",
            "lineageTag": "d003baaf-eecb-4355-9309-b65831be4982"
          },
          {
            "name": "Row Count All Stores",
            "expression": "CALCULATE(COUNTROWS(STORE_SALES), ALL(STORE))",
            "formatString": "#,##0",
            "displayFolder": "Calculate ALL",
            "lineageTag": "85a3fc92-9ec3-45c9-9f87-a38234a6bb3c"
          },
          {
            "name": "First Half Year Sales",
            "expression": "CALCULATE([Total Sales], DATE_DIM[D_QOY] IN {1, 2})",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate IN",
            "lineageTag": "f1847542-29cb-46bb-aef9-597b5eee3dcb"
          },
          {
            "name": "Non-Holiday Sales",
            "expression": "CALCULATE([Total Sales], NOT(DATE_DIM[D_HOLIDAY]=\"Y\"))",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate NOT",
            "lineageTag": "a6936ae2-be43-4e7e-99c4-178e077c67cf"
          },
          {
            "name": "High Value Sales",
            "expression": "CALCULATE([Total Sales], FILTER(STORE_SALES, STORE_SALES[SS_NET_PAID] > 100))",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate FILTER",
            "lineageTag": "1d108cc8-680f-4d42-972b-66eb538a4cfc"
          },
          {
            "name": "YTD Sales Via Filter",
            "expression": "CALCULATE([Total Sales], FILTER(ALL(DATE_DIM[D_DATE]), DATE_DIM[D_DATE] <= MAX(DATE_DIM[D_DATE])))",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate FILTER",
            "lineageTag": "1136cdba-cfda-4a14-af25-f492aa1bf090"
          },
          {
            "name": "Sales Per Year",
            "expression": "CALCULATE([Total Sales], ALLEXCEPT(DATE_DIM, DATE_DIM[D_YEAR]))",
            "formatString": "#,##0.00",
            "displayFolder": "Calculate ALLEXCEPT",
            "lineageTag": "27556240-aa43-4328-a9f2-3cea18e17f43"
          },
          {
            "name": "YTD Sales",
            "expression": "TOTALYTD([Total Sales], DATE_DIM[D_DATE])",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "0a468bc0-abf6-467e-8ebe-921eda3828b4"
          },
          {
            "name": "MTD Sales",
            "expression": "TOTALMTD([Total Sales], DATE_DIM[D_DATE])",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "46fccdf5-9749-433a-8095-fba6a7d80d28"
          },
          {
            "name": "QTD Sales",
            "expression": "TOTALQTD([Total Sales], DATE_DIM[D_DATE])",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "653f80dd-2935-420c-b6b5-56831e3ad96a"
          },
          {
            "name": "Sales Same Period Last Year",
            "expression": "CALCULATE([Total Sales], SAMEPERIODLASTYEAR(DATE_DIM[D_DATE]))",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "ae8cf13c-a1d3-44ed-a6c7-27bc0659374a"
          },
          {
            "name": "Sales Previous Month",
            "expression": "CALCULATE([Total Sales], PREVIOUSMONTH(DATE_DIM[D_DATE]))",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "31092d94-3884-4960-ba36-e8a2846bb561"
          },
          {
            "name": "Sales Parallel Period LY",
            "expression": "CALCULATE([Total Sales], PARALLELPERIOD(DATE_DIM[D_DATE], -1, YEAR))",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "bdf1e97a-b3bc-4978-b680-49117ee48efc"
          },
          {
            "name": "Closing Balance Month Sales",
            "expression": "CLOSINGBALANCEMONTH(SUM(STORE_SALES[SS_NET_PAID]), DATE_DIM[D_DATE])",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "eeb7a055-dbcd-4c03-b2b6-e79eff7d2a64"
          },
          {
            "name": "Sales Date Range",
            "expression": "CALCULATE([Total Sales], DATESBETWEEN(DATE_DIM[D_DATE], BLANK(), LASTDATE(DATE_DIM[D_DATE])))",
            "formatString": "#,##0.00",
            "displayFolder": "Time Intelligence",
            "lineageTag": "f0c44697-25da-40ed-9022-298361917474"
          },
          {
            "name": "Average Sale Amount",
            "expression": "DIVIDE([Total Sales], [Sales Count])",
            "formatString": "#,##0.00",
            "displayFolder": "Ratios",
            "lineageTag": "ca9baae6-318a-4e59-817b-61364094f7c8"
          },
          {
            "name": "Profit Margin",
            "expression": "DIVIDE([Total Profit], [Total Sales])",
            "formatString": "0.00%",
            "displayFolder": "Ratios",
            "lineageTag": "2e6a2a08-30b9-4006-b4f6-2c98858b0344"
          },
          {
            "name": "YoY Sales Growth",
            "expression": "DIVIDE([Total Sales] - [Sales Same Period Last Year], [Sales Same Period Last Year])",
            "formatString": "0.00%",
            "displayFolder": "Ratios",
            "lineageTag": "9e40c419-e1a0-4938-bb39-d19fbaedbbac"
          },
          {
            "name": "Sales Status",
            "expression": "IF([Total Sales] > 1000000, \"High\", \"Low\")",
            "displayFolder": "Conditional",
            "lineageTag": "1f071298-3cee-47f1-acec-da0d41cd03b1"
          },
          {
            "name": "Safe Division",
            "expression": "IFERROR([Profit Margin], 0)",
            "formatString": "0.00%",
            "displayFolder": "Conditional",
            "lineageTag": "fc85797e-a2e0-485d-a2ef-e5fd6ab1bd1d"
          },
          {
            "name": "Quarter Name",
            "expression": "SWITCH(MAX(DATE_DIM[D_QOY]), 1, \"Q1\", 2, \"Q2\", 3, \"Q3\", 4, \"Q4\", \"Unknown\")",
            "displayFolder": "Conditional",
            "lineageTag": "d59f32fd-2825-4d21-a6ca-419556c1696a"
          },
          {
            "name": "Complex Condition",
            "expression": "IF(AND([Total Sales] > 1000, [Profit Margin] > 0.05), \"Good\", \"Review\")",
            "displayFolder": "Conditional",
            "lineageTag": "63c66eb0-9d48-415f-b09d-5070362e8826"
          },
          {
            "name": "Weighted Avg Price",
            "expression": "SUMX(STORE_SALES, STORE_SALES[SS_QUANTITY] * STORE_SALES[SS_SALES_PRICE])",
            "formatString": "#,##0.00",
            "displayFolder": "Iteration",
            "lineageTag": "662129c9-2496-44b5-9a3c-1636bf5cd803"
          },
          {
            "name": "Max Year Sales",
            "expression": "MAXX(VALUES(DATE_DIM[D_YEAR]), [Total Sales])",
            "formatString": "#,##0.00",
            "displayFolder": "Iteration",
            "lineageTag": "235d069f-a7ab-4588-a797-4f591a8f55dc"
          },
          {
            "name": "Sales Per Store Iteration",
            "expression": "SUMX(VALUES(STORE[S_STORE_SK]), [Total Sales])",
            "formatString": "#,##0.00",
            "displayFolder": "Iteration",
            "lineageTag": "3d0d6577-21d2-443e-8b35-4e0027a092bc"
          },
          {
            "name": "Avg Sales Per Year",
            "expression": "AVERAGEX(VALUES(DATE_DIM[D_YEAR]), [Total Sales])",
            "formatString": "#,##0.00",
            "displayFolder": "Iteration",
            "lineageTag": "ef8b4f33-ca71-4e21-8167-7d8feb0ef8c2"
          },
          {
            "name": "Is Date Filtered",
            "expression": "ISFILTERED(DATE_DIM[D_DATE])",
            "displayFolder": "Filter Detection",
            "lineageTag": "0f622c4b-77d9-4a05-a375-b8b0ac7b2d2d"
          },
          {
            "name": "Is Store Crossfiltered",
            "expression": "ISCROSSFILTERED(STORE)",
            "displayFolder": "Filter Detection",
            "lineageTag": "82cba4bc-2056-4293-8607-1d6523de05e8"
          },
          {
            "name": "Has One Year",
            "expression": "HASONEVALUE(DATE_DIM[D_YEAR])",
            "displayFolder": "Filter Detection",
            "lineageTag": "f282ced1-c56d-49ac-ad47-712a7c51224a"
          },
          {
            "name": "Conditional Sales Display",
            "expression": "IF(ISFILTERED(DATE_DIM), [Total Sales], BLANK())",
            "formatString": "#,##0.00",
            "displayFolder": "Filter Detection",
            "lineageTag": "c8963864-3778-4323-98b7-69715e87f525"
          },
          {
            "name": "Selected Year",
            "expression": "IF(HASONEVALUE(DATE_DIM[D_YEAR]), VALUES(DATE_DIM[D_YEAR]), BLANK())",
            "formatString": "#,##0",
            "displayFolder": "Filter Detection",
            "lineageTag": "381248c0-bb28-4ca2-9737-3d5a65d08e8b"
          },
          {
            "name": "Max Date",
            "expression": "MAX(DATE_DIM[D_DATE])",
            "formatString": "Short Date",
            "displayFolder": "Date Functions",
            "lineageTag": "fc2f7801-5adf-4017-b6d1-5248b54a1e7d"
          },
          {
            "name": "Days Since Last Sale",
            "expression": "DATEDIFF(MAX(DATE_DIM[D_DATE]), TODAY(), DAY)",
            "formatString": "#,##0",
            "displayFolder": "Date Functions",
            "lineageTag": "4c6fe7a1-5cd9-42c6-b731-cc48cc6454da"
          },
          {
            "name": "End of Month Date",
            "expression": "EOMONTH(MAX(DATE_DIM[D_DATE]), 0)",
            "formatString": "Short Date",
            "displayFolder": "Date Functions",
            "lineageTag": "4919b079-368c-48a1-8fad-5a023895f4ce"
          },
          {
            "name": "Absolute Profit",
            "expression": "ABS([Total Profit])",
            "formatString": "#,##0.00",
            "displayFolder": "Math Functions",
            "lineageTag": "34a8228b-0ac4-46f1-86af-a5ea4db97c2d"
          },
          {
            "name": "Rounded Sales",
            "expression": "ROUND([Total Sales], -3)",
            "formatString": "#,##0",
            "displayFolder": "Math Functions",
            "lineageTag": "a42e3d18-4626-40a6-9c10-a6a496495aeb"
          },
          {
            "name": "Nested IF Calculate",
            "expression": "IF([Is Date Filtered], DIVIDE(TOTALYTD([Total Sales], DATE_DIM[D_DATE]), [Sales Row Count]) * [Sales Row Count], CALCULATE(TOTALYTD([Total Sales], DATE_DIM[D_DATE]), DATE_DIM[D_CURRENT_YEAR]=\"Y\"))",
            "formatString": "#,##0.00",
            "displayFolder": "Complex Patterns",
            "lineageTag": "0e97a5e7-a421-45e7-983f-dfe4608273af"
          },
          {
            "name": "Combined Variance",
            "expression": "[Total Sales] - [Sales Same Period Last Year]",
            "formatString": "#,##0.00",
            "displayFolder": "Complex Patterns",
            "lineageTag": "07b0504b-bc37-4739-a6ba-8a614a4c4993"
          },
          {
            "name": "Web Sales Total",
            "expression": "SUM(WEB_SALES[WS_NET_PAID])",
            "formatString": "#,##0.00",
            "displayFolder": "Multi-Channel",
            "lineageTag": "4e3cdcc2-7892-4618-96b5-e15020b25a91"
          },
          {
            "name": "Catalog Sales Total",
            "expression": "SUM(CATALOG_SALES[CS_NET_PAID])",
            "formatString": "#,##0.00",
            "displayFolder": "Multi-Channel",
            "lineageTag": "ea3eaa32-2e5e-437a-a450-7784a17ebade"
          },
          {
            "name": "Combined Sales",
            "expression": "[Total Sales] + [Web Sales Total] + [Catalog Sales Total]",
            "formatString": "#,##0.00",
            "displayFolder": "Multi-Channel",
            "lineageTag": "b84910cf-632f-42b2-9a73-f7dfa429bcf5"
          },
          {
            "name": "Total Returns",
            "expression": "SUM(STORE_RETURNS[SR_RETURN_AMT])",
            "formatString": "#,##0.00",
            "displayFolder": "Returns",
            "lineageTag": "79d970c9-1650-4b51-a81b-e6e067d41212"
          },
          {
            "name": "Store Sales Amount",
            "expression": "SUM(STORE_SALES[SS_NET_PAID])",
            "formatString": "#,##0.00",
            "displayFolder": "Store Metrics",
            "lineageTag": "c6056fda-1c5e-443b-83f3-0e7645568c2e"
          },
          {
            "name": "Store Sales Qty",
            "expression": "SUM(STORE_SALES[SS_QUANTITY])",
            "formatString": "#,##0",
            "displayFolder": "Store Metrics",
            "lineageTag": "3f795192-76e3-4b68-b2f6-70730fc46667"
          },
          {
            "name": "Store Profit",
            "expression": "SUM(STORE_SALES[SS_NET_PROFIT])",
            "formatString": "#,##0.00",
            "displayFolder": "Store Metrics",
            "lineageTag": "20e4336e-e847-404c-85c2-a57c6bbfa9df"
          }
        ],
