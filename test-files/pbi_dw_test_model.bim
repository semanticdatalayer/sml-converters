        "measures": [
          {
            "name": "Total Sales",
            "expression": "SUM(STORE_SALES[SS_NET_PAID])",
            "formatString": "#,##0.00",
            "displayFolder": "Basic Aggregations",
            "lineageTag": "def81046-093b-486b-afb8-e800f998fa8e"
          },
          {
            "name": "Total Profit",
            "expression": "SUM(STORE_SALES[SS_NET_PROFIT])",
            "formatString": "#,##0.00",
            "displayFolder": "Basic Aggregations",
            "lineageTag": "aa6640e4-d726-4da6-b400-c7223da1e526"
          },
          {
            "name": "Sales Count",
            "expression": "COUNT(STORE_SALES[SS_TICKET_NUMBER])",
            "formatString": "#,##0",
            "displayFolder": "Basic Aggregations",
            "lineageTag": "61e3b752-5aa4-4e63-8c4e-968da260a63d"
          },
          {
            "name": "Sales Row Count",
            "expression": "COUNTROWS(STORE_SALES)",
            "formatString": "#,##0",
            "displayFolder": "Basic Aggregations",
            "lineageTag": "9e08bdc6-4b97-47be-bd64-12c0a13ebe2d"
          },
          {
            "name": "Average Sale Price",
            "expression": "AVERAGE(STORE_SALES[SS_SALES_PRICE])",
            "formatString": "#,##0.00",
            "displayFolder": "Basic Aggregations",
            "lineageTag": "17f18c9f-36e0-4721-85e2-aa15fc8d400b"
          },
          {
            "name": "Min Sale Price",
