  "dimensions": [
    {
      "name": "AGE",
      "table": "CUSTOMER",
      "parent_entity": "CUSTOMER",
      "expression": "(YEAR(CURRENT_DATE())-C_BIRTH_YEAR)",
      "data_type": "NUMBER(38,0)",
      "access_modifier": "PUBLIC"
    },
    {
      "name": "AGE_BUCKET",
      "table": "CUSTOMER",
      "parent_entity": "CUSTOMER",
      "expression": "(CASE \n            WHEN AGE < 20 THEN '0-19'\n            WHEN AGE BETWEEN 20 AND 39 THEN '20-39'\n            WHEN AGE BETWEEN 40 AND 59 THEN '40-59'\n            WHEN AGE BETWEEN 60 AND 79 THEN '60-79'\n            WHEN AGE BETWEEN 80 AND 99 THEN '80-99'\n            ELSE '100+'\n        END)",
      "data_type": "VARCHAR(5)",
      "access_modifier": "PUBLIC"
    },
    {
      "name": "BIRTHYEAR",
      "table": "CUSTOMER",
      "parent_entity": "CUSTOMER",
      "expression": "C_BIRTH_YEAR",
      "data_type": "NUMBER(38,0)",
      "access_modifier": "PUBLIC"
    },
    {
      "name": "COUNTRY",
      "table": "CUSTOMER",
      "parent_entity": "CUSTOMER",
      "expression": "C_BIRTH_COUNTRY",
      "data_type": "VARCHAR(20)",
      "access_modifier": "PUBLIC"
    },
    {
      "name": "VALUE_BUCKET",
      "table": "CUSTOMER",
      "parent_entity": "CUSTOMER",
      "expression": "(CASE \n            WHEN CUSTOMER.F_REVENUE_PER_CUSTOMER < 1000 THEN 'low value'\n            WHEN CUSTOMER.F_REVENUE_PER_CUSTOMER BETWEEN 1000 AND 3000 THEN 'medium value'\n            ELSE 'high value'\n        END)",
      "data_type": "VARCHAR(12)",
      "access_modifier": "PUBLIC"
    },
