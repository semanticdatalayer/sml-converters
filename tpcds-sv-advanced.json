      ],
      "access_modifier": "PUBLIC"
    },
    {
      "name": "TOTAL_SALES_PRICE",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "SUM(SS_SALES_PRICE)",
