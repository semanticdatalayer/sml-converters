  "metrics": [
    {
      "name": "AVG_7_DAYS_SALES_QUANTITY",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "AVG(TOTAL_SALES_QUANTITY) \n         OVER (PARTITION BY EXCLUDING DATE.DATE ORDER BY DATE.DATE RANGE BETWEEN INTERVAL '6 days' \n         PRECEDING AND CURRENT ROW)",
      "data_type": "NUMBER(38,3)",
      "synonyms": [
        "running 7 day average of total sales quantity"
      ],
      "access_modifier": "PUBLIC"
    },
    {
      "name": "AVG_7_DAYS_SALES_QUANTITY_30DAY",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "AVG(TOTAL_SALES_QUANTITY) \n         OVER (PARTITION BY EXCLUDING DATE.DATE ORDER BY DATE.DATE RANGE BETWEEN INTERVAL '36 days' \n         PRECEDING AND INTERVAL '30 days' PRECEDING)",
      "data_type": "NUMBER(38,3)",
      "synonyms": [
        "running 7 day average of total sales quantity 30 days ago"
      ],
      "access_modifier": "PUBLIC"
    },
    {
      "name": "CUSTOMER_COUNT",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "COUNT(DISTINCT SS_CUSTOMER_SK)",
      "data_type": "NUMBER(18,0)",
      "synonyms": [
        "count of customers with sales in period, active customers with sales"
      ],
      "access_modifier": "PUBLIC"
    },
    {
      "name": "NET_PROFIT__MARGIN_AFTER_TAX",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "SUM((STORESALES.SS_SALES_PRICE-item.cost)/item.cost)/SUM(STORESALES.SS_QUANTITY)",
      "data_type": "NUMBER(32,12)",
      "synonyms": [
        "net profit margin after item cost and applying taxes"
      ],
      "access_modifier": "PUBLIC"
    },
    {
      "name": "NET_SALES_PROFIT_AFTER_TAX",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "SUM((STORESALES.SS_SALES_PRICE-item.cost)*(1-STORE.TAX_RATE))",
      "data_type": "NUMBER(26,4)",
      "synonyms": [
        "net sales profit after item cost and applying taxes"
      ],
      "access_modifier": "PUBLIC"
    },
    {
      "name": "REVENUE_PER_CUSTOMER",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "(SUM(SS_QUANTITY)/COUNT(DISTINCT SS_CUSTOMER_SK))",
      "data_type": "NUMBER(38,6)",
      "synonyms": [
        "total sales revenue per active customer"
      ],
      "access_modifier": "PUBLIC"
    },
    {
      "name": "TOTAL_COST",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "SUM(item.cost)",
      "data_type": "NUMBER(19,2)",
      "synonyms": [
