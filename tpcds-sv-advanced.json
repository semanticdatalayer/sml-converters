    },
    {
      "name": "TOTAL_SALES_QUANTITY_30DAY",
      "table": "STORESALES",
      "parent_entity": "STORESALES",
      "expression": "LAG(TOTAL_SALES_QUANTITY,30)\n         OVER (PARTITION BY EXCLUDING DATE.DATE ORDER BY DATE.DATE)",
      "data_type": "NUMBER(38,0)",
      "synonyms": [
        "sales quantity 30 days ago"
      ],
      "access_modifier": "PUBLIC"
    }
  ]
